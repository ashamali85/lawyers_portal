# PostgreSQL (Neon) — pooled connection string for queries
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection (no -pooler) for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Session signing secret — must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL of the app
APP_URL="http://localhost:3000"

# Vercel Blob (resume storage) — from your Vercel project's Blob store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Seed admin credentials (used once by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
